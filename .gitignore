# ==========================================
# GIT IGNORE - Web Toko Project
# ==========================================

# -- Dependencies --
# Jangan upload node_modules karena sangat berat dan bisa diinstall ulang lewat 'npm install'
node_modules/
backend/node_modules/
vite-project/node_modules/

# -- Security / Secrets --
# Jangan upload file .env karena berisi password database atau kunci rahasia (API Keys)
.env
.env.local
.env.*.local
*.local
backend/.env

# -- Build Output --
# File hasil kompilasi tidak perlu karena akan dibuat ulang saat deployment
dist/
dist-ssr/
build/
vite-project/dist/

# -- OS / Editor --
# File sampah dari sistem operasi atau pengaturan editor pribadi
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -- Logs --
# Catatan error tidak perlu masuk ke repository
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -- Project Specific --
# Script temporary atau folder upload dari user (data dinamis)
generet-hashes.js
backend/uploads/*
!backend/uploads/.gitkeep
tmp/
temp/
